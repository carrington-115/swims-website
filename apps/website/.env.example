# The site's own origin -- scheme and host, no trailing slash.
#
# Canonical links, the sitemap and every share-preview image are built from
# this, and a scraper cannot resolve a relative URL, so it has to be the address
# people actually visit rather than a preview one.
#
# Optional on Vercel: with nothing set, the site falls back to the project's
# production domain (which becomes the custom domain once one is assigned), and
# then to the deployment URL. Set it explicitly when the site is reached by a
# domain the Vercel project does not know it owns.
# NEXT_PUBLIC_SITE_URL=https://swims.africa

# Where the Blogs API is listening.
#
# Public on purpose: the blog listing and the post pages are fetched from the
# browser as well as prefetched on the server, so this value is inlined into the
# client bundle. Nothing secret goes over it -- the website reads only published
# posts, and never sends a token.
#
# The API's CORS_ORIGINS must name this site's origin (http://localhost:3000 in
# development), or the browser half of those reads is refused.
NEXT_PUBLIC_BLOGS_API_URL=http://localhost:3002
