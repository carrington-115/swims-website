{
  "name": "swims-blogs-api",
  "version": "0.1.0",
  "private": true,
  "description": "Blogs API - Express + TypeScript + Supabase backend for SWIMS blog content",
  "main": "dist/server.js",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "check:db": "tsx src/scripts/check-supabase.ts",
    "schema": "tsx src/scripts/show-schema.ts",
    "db:apply": "tsx src/scripts/apply-schema.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@swims/schemas": "workspace:*",
    "express": "^5.1.0",
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "zod": "^4.0.0",
    "express-rate-limit": "^7.4.0"
  },
  "devDependencies": {
    "@swims/eslint-config": "workspace:*",
    "eslint": "^9",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.0.0"
  }
}
