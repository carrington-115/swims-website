# The Supabase project the Blogs API is wired to. Both values are safe in the
# browser: the publishable key is bound by row level security, and sign-in
# happens directly against Supabase Auth from here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Where the Blogs API is listening. The dashboard calls it from the server with
# the signed-in user's access token, so this never needs to be reachable from a
# browser.
BLOGS_API_URL=http://localhost:3002
