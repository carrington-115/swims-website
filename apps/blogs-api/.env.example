# Supabase project credentials.
# Dashboard -> Project Settings -> API keys.
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...). Safe to expose, bound by row level
# security. This API uses it only to verify caller JWTs.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Secret key (sb_secret_...). Bypasses row level security. Server-only -- never
# commit it, never ship it to a browser, never put it in a NEXT_PUBLIC_ var.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# On a project that still issues the legacy JWT keys, use these names instead.
# Both generations are accepted; the current names above win if both are set.
# SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

NODE_ENV=development
PORT=3002

# Comma-separated allowlist. The website (3000) and the dashboard (3001) are
# separate origins and both call this API, so this is a list rather than one
# value.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001